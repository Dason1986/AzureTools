<Window x:Class="AzureTools.Views.KeyVaults.KeyVaultSecretCompareView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AzureTools.ViewModels;assembly=AzureTools"
        xmlns:res="clr-namespace:AzureTools.Properties;assembly=AzureTools"
        xmlns:conv="clr-namespace:AzureTools.Converters;assembly=AzureTools"
        x:DataType="vm:KeyVaultSecretCompareViewModel"
        xmlns:bh="clr-namespace:AzureTools.Behaviors;assembly=AzureTools"
        Title="{x:Static res:FormResources.TitleKeyVaultCompare}"
        Width="1150"
        Height="750"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:CompareResultLookupConverter x:Key="CompareResultLookupConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="{x:Static res:FormResources.BtnShowAll}"
                    Command="{Binding ShowAllCommand}"
                    Padding="20,8"
                    Margin="0,0,10,0"/>
            <Button Content="{x:Static res:FormResources.BtnShowDiff}"
                    Command="{Binding ShowDiffCommand}"
                    Padding="20,8" 
                    Margin="0,0,10,0"/>
            <Button Grid.Row="3"
                    Content="{x:Static res:FormResources.BtnExportResult}"
                    Command="{Binding ExportCommand}"
                    Padding="20,8"
                    />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  x:Name="dgvResult"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedCompareResult}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  bh:DataGridAssist.EnableStoppedRowHighlight="True"
                  bh:DataGridAssist.HighlightStatusValue="Partial"
                  Margin="10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColKeyName}"
                                    Binding="{Binding KeyName}"
                                    Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="{Binding SummaryText}"
                   FontWeight="Bold"
                   Margin="10,5"/>

        <GroupBox Grid.Row="3"
                  Header="{x:Static res:FormResources.GrpValue}"
                  Padding="10"
                  Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="180">
                <StackPanel x:Name="ValuesPanel"/>
            </ScrollViewer>
        </GroupBox>

    
    </Grid>
</Window>