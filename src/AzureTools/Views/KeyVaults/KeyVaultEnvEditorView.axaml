<Window x:Class="AzureTools.Views.KeyVaults.KeyVaultEnvEditorView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:vm="clr-namespace:AzureTools.ViewModels.KeyVaults;assembly=AzureTools"
        xmlns:res="clr-namespace:AzureTools.Properties;assembly=AzureTools"
        x:DataType="vm:KeyVaultEnvEditorViewModel"
        Title="{x:Static res:FormResources.TitleEditEnv}"
        Width="450"
        Height="380"
        MinWidth="400"
        MinHeight="350"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <StackPanel Margin="15" Spacing="8">
        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblName}" Classes="field-label" MinWidth="100"/>
            <TextBox Text="{Binding Name}"
                     PlaceholderText="请输入环境名称"/>
        </DockPanel>

        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblKeyVault}" Classes="field-label" MinWidth="100"/>
            <TextBox Text="{Binding KeyVault}"
                     IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolean}}"
                     PlaceholderText="请输入KeyVault名称"/>
        </DockPanel>

        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblKeyVaultUrl}" Classes="field-label" MinWidth="100"/>
            <TextBox Text="{Binding KeyVaultUrl}"
                     IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolean}}"
                     PlaceholderText="https://your-vault.vault.azure.net/"/>
        </DockPanel>
        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblResourceGroup}" Classes="field-label" MinWidth="100"/>
            <TextBox Text="{Binding ResourceGroupName}"
                     IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolean}}"
                     PlaceholderText="请输入资源组名称"/>
        </DockPanel>
        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblSubscriptionName}" Classes="field-label" MinWidth="100"/>
            <TextBox Text="{Binding SubscriptionName}"
                     IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolean}}"
                     PlaceholderText="请输入订阅名称"/>
        </DockPanel>

        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblSubscriptionId}" Classes="field-label" MinWidth="100"/>
            <TextBox Text="{Binding SubscriptionId}"
                     IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolean}}"
                     PlaceholderText="请输入订阅ID"/>
        </DockPanel>
        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblEnableSoftDelete}" Classes="field-label" MinWidth="100"/>
            <CheckBox
                  IsChecked="{Binding EnableSoftDelete}"
                  IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolean}}"
                  Margin="0,5,0,5"/>
        </DockPanel>


        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{x:Static res:FormResources.BtnCancel}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Classes="form-action"
                    Margin="0,0,10,0"/>
            <Button Content="{x:Static res:FormResources.BtnConfirm}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    Classes="form-action"/>
        </StackPanel>
    </StackPanel>
</Window>
