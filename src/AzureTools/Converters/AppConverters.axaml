<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AzureTools.Converters;assembly=AzureTools.Avalonia" 
                    >
  <conv:TagsToStringConverter x:Key="TagsToString"/>
  <conv:DateTimeFormatConverter x:Key="DateTimeFormat"/>
  <conv:InvertedBooleanConverter x:Key="InvertedBoolean"/>
  <conv:SizeToStringConverter x:Key="SizeToString"/>
  <conv:ByteArrayToImageConverter x:Key="ByteArrayToImage"/>
  <conv:StringNotEmptyConverter x:Key="StringNotEmpty"/>
  <conv:BoolToColorConverter x:Key="BoolToColor"/>
  <conv:StringBooleanConverter x:Key="StringBoolean"/>
  <conv:FileIconConverter x:Key="FileIcon"/>
</ResourceDictionary>
