<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:AzureTools.Models;assembly=AzureTools.Domain">
    <Color x:Key="SystemAccentColor">#0A6EBD</Color>
    <Color x:Key="SystemAccentColorDark1">#085A9E</Color>
    <Color x:Key="SystemAccentColorDark2">#06487E</Color>
    <Color x:Key="SystemAccentColorDark3">#04365E</Color>
    <Color x:Key="SystemAccentColorLight1">#3A8BCE</Color>
    <Color x:Key="SystemAccentColorLight2">#6BA9DC</Color>
    <Color x:Key="SystemAccentColorLight3">#9CC7EA</Color>
    <CornerRadius x:Key="AppControlCornerRadius">6</CornerRadius>
    <Thickness x:Key="AppControlPadding">12,8</Thickness>
    <ControlTheme x:Key="OptionComboBoxItemTheme" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}" x:DataType="models:IOption">
        <Setter Property="IsEnabled" Value="{Binding !Disabled}"/>
    </ControlTheme>
</ResourceDictionary>
