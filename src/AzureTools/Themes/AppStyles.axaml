<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource AppControlPadding}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="{DynamicResource AppControlCornerRadius}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#PART_BackgroundBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="GroupBox">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="GroupBox /template/ Border#PART_HeaderBorder">
        <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style Selector="GroupBox /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppHeaderText}"/>
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource AppColumnHeader}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppHeaderText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource AppRowHover}"/>
    </Style>
    <Style Selector="DataGridRow:selected /template/ Border">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppRowHover}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:unfocused /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppRowHover}"/>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="0 2 8 0 #14000000"/>
    </Style>
    <Style Selector="TextBlock.header">
        <Setter Property="Foreground" Value="{DynamicResource AppHeaderText}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.subheader">
        <Setter Property="Foreground" Value="{DynamicResource AppSubHeaderText}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="TextBlock.field-label">
        <Setter Property="MinWidth" Value="70"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="DockPanel.Dock" Value="Left"/>
    </Style>
    <Style Selector="Button.form-action">
        <Setter Property="Padding" Value="20,8"/>
    </Style>
    <Style Selector="Button.menu-card">
        <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.menu-card:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight1}"/>
        <Setter Property="Background" Value="{DynamicResource AppRowHover}"/>
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{DynamicResource AppBadgeBackground}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="6"/>
    </Style>
</Styles>
