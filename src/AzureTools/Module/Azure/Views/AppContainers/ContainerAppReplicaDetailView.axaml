<Window x:Class="AzureTools.Module.Azure.Views.AppContainers.ContainerAppReplicaDetailView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AzureTools.Module.Azure.ViewModels.AppContainers;assembly=AzureTools"
        xmlns:res="clr-namespace:AzureTools.Properties;assembly=AzureTools"
        
        x:DataType="vm:ContainerAppReplicaDetailViewModel"
        Title="{Binding WindowTitle}"
        Width="900"
        Height="550"
        MinWidth="600"
        MinHeight="350"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:FormResources.LblName}" Classes="field-label" Margin="0,5"/>
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Replica.Name}" Margin="0,5" TextWrapping="Wrap"/>

      <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:FormResources.LblRevision}" Classes="field-label" Margin="0,5"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Replica.RevisionName}" Margin="0,5" TextWrapping="Wrap"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:FormResources.LblRunningState}" Classes="field-label" Margin="0,5"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Replica.RunningState}" Margin="0,5"/>

      <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static res:FormResources.LblCreated}" Classes="field-label" Margin="0,5"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Replica.CreatedOn, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}" Margin="0,5"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:FormResources.LblRunningStateDetails}" Classes="field-label" Margin="0,5"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Replica.RunningStateDetails}" Margin="0,5" TextWrapping="Wrap"/>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal"   Margin="0,0,0,10">

      <TextBlock Text="{x:Static res:FormResources.LblContainer}" Classes="field-label" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox ItemsSource="{Binding Containers}"
                SelectedItem="{Binding SelectedContainer}"
                Width="200"
                Margin="0,0,10,0">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="{x:Static res:FormResources.BtnEnterContainer}" IsVisible="{Binding SupprotEnterContainer}" Command="{Binding EnterContainerCommand}"/>
      <Button Content="{x:Static res:FormResources.BtnContainerLogs}" IsVisible="{Binding SupprotContainerLogs}" Command="{Binding GetLogsCommand}"/>
      <Button Content="{x:Static res:FormResources.BtnFileBrowser}" IsVisible="{Binding SupprotEnterContainer}" Command="{Binding OpenFileBrowserCommand}"/>

    </StackPanel>

    <TextBlock Grid.Row="2" Text="{x:Static res:FormResources.LblContainers}" FontWeight="Bold" Margin="0,0,0,5" VerticalAlignment="Top"/>
    <DataGrid Grid.Row="2"
              ItemsSource="{Binding Containers}"
              SelectedItem="{Binding SelectedContainer}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              Margin="0,25,0,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblName}"
                            Binding="{Binding Name}"
                            Width="120"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblContainerId}"
                            Binding="{Binding ContainerId}"
                            Width="*"/>
        <DataGridCheckBoxColumn Header="{x:Static res:FormResources.LblReady}"
                                Binding="{Binding IsReady}"
                                Width="70"/>
        <DataGridCheckBoxColumn Header="{x:Static res:FormResources.LblStarted}"
                                Binding="{Binding IsStarted}"
                                Width="70"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblRestartCount}"
                            Binding="{Binding RestartCount}"
                            Width="80"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblRunningState}"
                            Binding="{Binding RunningState}"
                            Width="100"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblRunningStateDetails}"
                            Binding="{Binding RunningStateDetails}"
                            Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
