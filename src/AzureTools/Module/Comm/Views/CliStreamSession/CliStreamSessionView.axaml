<Window x:Class="AzureTools.Module.Comm.Views.CliStreamSession.CliStreamSessionView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AzureTools.Module.Comm.ViewModels.CliStreamSession;assembly=AzureTools"
        xmlns:res="clr-namespace:AzureTools.Properties;assembly=AzureTools"
        x:DataType="vm:CliStreamSessionViewModel"
        Title="{Binding WindowTitle}"
        Width="900"
        Height="600"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding WindowTitle}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Button Grid.Column="1" Content="{x:Static res:FormResources.BtnClear}" Command="{Binding ClearCommand}" Margin="4,0,0,0"/>
      <Button Grid.Column="2" Content="{x:Static res:FormResources.BtnStop}" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Margin="4,0,0,0"/>
      <Button Grid.Column="3" Content="{x:Static res:FormResources.BtnClose}" Command="{Binding CloseCommand}" Margin="4,0,0,0"/>
    </Grid>

    <Grid DockPanel.Dock="Bottom" Margin="8,4,8,8" IsVisible="{Binding IsInteractive}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0"
               Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
               Watermark="{x:Static res:FormResources.LblInputPlaceholder}"
               IsEnabled="{Binding IsRunning}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendInputCommand}"/>
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Content="{x:Static res:FormResources.BtnSend}" Command="{Binding SendInputCommand}" IsEnabled="{Binding IsRunning}" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </Grid>

    <ScrollViewer x:Name="LogScroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Background="#1E1E1E"
                  Padding="4">
      <ItemsControl ItemsSource="{Binding OutputLines}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <SelectableTextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13" TextWrapping="NoWrap" Foreground="#DCDCDC"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
