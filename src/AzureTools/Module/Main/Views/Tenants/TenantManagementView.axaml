<Window x:Class="AzureTools.Module.Main.Views.Tenants.TenantManagementView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AzureTools.Module.Main.ViewModels.Tenants;assembly=AzureTools"
        xmlns:res="clr-namespace:AzureTools.Properties;assembly=AzureTools"
        x:DataType="vm:TenantManagementViewModel"
        Title="{x:Static res:FormResources.TitleTenantManage}"
        Width="900"
        Height="500"
        MinWidth="600"
        MinHeight="350"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static res:FormResources.BtnAdd}"
                            Command="{Binding AddCommand}"
                            IsEnabled="{Binding AddEnabled}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnEdit}"
                            Command="{Binding EditCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnDelete}"
                            Command="{Binding DeleteCommand}"
                            Padding="20,8"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{x:Static res:FormResources.BtnRefresh}"
                            Command="{Binding RefreshCommand}"
                            Padding="20,8"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColTenantName}"
                                    Binding="{Binding Name}"
                                    Width="*"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColTenantCode}"
                                    Binding="{Binding Code}"
                                    Width="120"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColTenantId}"
                                    Binding="{Binding TenantId}"
                                    Width="200"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColClientId}"
                                    Binding="{Binding ClientId}"
                                    Width="200"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColCredential}"
                                    Binding="{Binding Credential}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>