<Window x:Class="AzureTools.Module.Main.Views.MainView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AzureTools.Module.Main.Views;assembly=AzureTools"
        xmlns:vm="clr-namespace:AzureTools.Module.Main.ViewModels;assembly=AzureTools"
        x:DataType="vm:MainViewModel"
        Title="Azure Tools"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" Classes="card" CornerRadius="0" BoxShadow="0 1 4 0 #10000000">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding CurrentModuleName}" FontSize="22" FontWeight="Bold" Classes="header"/>
                <TextBlock Text="v1.0" FontSize="12" Classes="subheader" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Modules}"
                    SelectedItem="{Binding SelectedModule}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MenuModule">
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:MenuModule">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MenuItemCard">
                                    <Button Classes="menu-card"
                                            Command="{Binding ClickCommand}"
                                            Padding="20,15"
                                            Margin="10"
                                            MinWidth="150">
                                        <Grid>
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon, Converter={StaticResource ByteArrayToImage}}"
                                                       Width="126" Height="126"
                                                       Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding Text}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           Height="38"
                                                           Classes="header"
                                                           FontSize="13"/>
                                            </StackPanel>
                                            <Border Classes="badge" IsVisible="{Binding !IsEnabled}">
                                                <TextBlock Text="未开放" Foreground="White" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>