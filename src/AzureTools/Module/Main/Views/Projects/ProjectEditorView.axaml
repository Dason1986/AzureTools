<Window x:Class="AzureTools.Module.Main.Views.Projects.ProjectEditorView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AzureTools.Module.Main.ViewModels.Projects;assembly=AzureTools"
        xmlns:res="clr-namespace:AzureTools.Properties;assembly=AzureTools"
        x:DataType="vm:ProjectEditorViewModel"
        Title="{x:Static res:FormResources.TitleEditProject}"
        Width="450"
        Height="320"
        MinWidth="400"
        MinHeight="280"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <StackPanel Margin="15" Spacing="8">
        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblProjectCode}" Classes="field-label"/>
            <TextBox Text="{Binding Code}"
                     PlaceholderText="请输入项目代码"/>
        </DockPanel>

        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblProjectName}" Classes="field-label"/>
            <TextBox Text="{Binding Name}"
                     PlaceholderText="请输入项目名称"/>
        </DockPanel>

        <DockPanel>
            <TextBlock Text="{x:Static res:FormResources.LblDescription}" Classes="field-label" VerticalAlignment="Top"/>
            <TextBox Text="{Binding Description}"
                     AcceptsReturn="True"
                     Height="80"
                     PlaceholderText="请输入项目描述"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{x:Static res:FormResources.BtnCancel}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Classes="form-action"
                    Margin="0,0,10,0"/>
            <Button Content="{x:Static res:FormResources.BtnConfirm}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"
                    Classes="form-action"/>
        </StackPanel>
    </StackPanel>
</Window>