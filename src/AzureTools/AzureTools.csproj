<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    <SignAssembly>False</SignAssembly>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ToolPackageRuntimeIdentifiers>osx-arm64;linux-arm64;linux-x64;any</ToolPackageRuntimeIdentifiers>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="publish\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.Query.Logs" />
    <PackageReference Include="Azure.ResourceManager" />
    <PackageReference Include="Azure.ResourceManager.AppContainers" />
    <PackageReference Include="Azure.ResourceManager.ApplicationInsights" />
    <PackageReference Include="Azure.ResourceManager.Compute" />
    <PackageReference Include="Azure.ResourceManager.ContainerInstance" />
    <PackageReference Include="Azure.ResourceManager.ContainerRegistry" />
    <PackageReference Include="Azure.ResourceManager.ContainerService" />
    <PackageReference Include="Azure.ResourceManager.KeyVault" />
    <PackageReference Include="Azure.ResourceManager.Monitor" />
    <PackageReference Include="Azure.ResourceManager.Redis" />
    <PackageReference Include="Azure.Containers.ContainerRegistry" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="Microsoft.Azure.NotificationHubs" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="NPOI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="System.Linq.Async" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\FormResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FormResources.resx</DependentUpon>
    </Compile>
    <Compile Update="Module\Azure\Views\AppContainers\AppContainerEnvManageView.axaml.cs">
      <DependentUpon>AppContainerEnvManageView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Module\Azure\Views\AppContainers\AppContainerEnvEditorView.axaml.cs">
      <DependentUpon>AppContainerEnvEditorView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Module\Azure\Views\ContainerRegistries\ContainerRegistryEnvManageView.axaml.cs">
      <DependentUpon>ContainerRegistryEnvManageView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Module\Azure\Views\ContainerRegistries\ContainerRegistryEnvEditorView.axaml.cs">
      <DependentUpon>ContainerRegistryEnvEditorView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Module\Azure\Views\KeyVaults\KeyVaultEnvManageView.axaml.cs">
      <DependentUpon>KeyVaultEnvManageView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Module\Azure\Views\KeyVaults\KeyVaultEnvEditorView.axaml.cs">
      <DependentUpon>KeyVaultEnvEditorView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Module\Azure\Views\KeyVaults\SecretKeyEditorView.axaml.cs">
      <DependentUpon>SecretKeyEditorView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Module\Main\Views\Projects\ProjectEditorView.axaml.cs">
      <DependentUpon>ProjectEditorView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Module\Main\Views\Tenants\TenantEditorView.axaml.cs">
      <DependentUpon>TenantEditorView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\MessageResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>MessageResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\ModelResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ModelResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\FormResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>FormResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Base" />
    <TrimmerRootAssembly Include="Avalonia.Controls" />
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />
    <TrimmerRootAssembly Include="Avalonia.Controls.WebView" />
    <TrimmerRootAssembly Include="Avalonia.Desktop" />
    <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
    <TrimmerRootAssembly Include="Avalonia.Skia" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureTools.Abstractions\AzureTools.Abstractions.csproj" />
    <ProjectReference Include="..\AzureTools.Avalonia\AzureTools.Avalonia.csproj" />
    <ProjectReference Include="..\AzureTools.Domain\AzureTools.Domain.csproj" />
    <ProjectReference Include="..\AzureTools.SDK\AzureTools.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Cli\" />
    <Folder Include="Properties\PublishProfiles\" />
  </ItemGroup>

</Project>