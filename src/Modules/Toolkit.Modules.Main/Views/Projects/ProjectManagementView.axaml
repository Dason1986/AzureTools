<Window x:Class="Toolkit.Modules.Main.Views.Projects.ProjectManagementView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Main.ViewModels.Projects;assembly=Toolkit.Modules.Main"
        xmlns:res="clr-namespace:Toolkit.Modules.Properties;assembly=Toolkit.Modules.Resources"
        x:DataType="vm:ProjectManagementViewModel"
        Title="{x:Static res:FormResources.TitleProjectManage}"
        Width="800"
        Height="450"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static res:FormResources.BtnAdd}"
                            Command="{Binding AddCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnEdit}"
                            Command="{Binding EditCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnDelete}"
                            Command="{Binding DeleteCommand}"
                            Padding="20,8"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{x:Static res:FormResources.BtnRefresh}"
                            Command="{Binding RefreshCommand}"
                            Padding="20,8"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColCode}"
                                    Binding="{Binding Code}"
                                    Width="150"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColName}"
                                    Binding="{Binding Name}"
                                    Width="*"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColDescription}"
                                    Binding="{Binding Description}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>