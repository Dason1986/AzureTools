<Window x:Class="Toolkit.Modules.Main.Views.AppWizardView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Main.ViewModels;assembly=Toolkit.Modules.Main"
        xmlns:res="clr-namespace:Toolkit.Modules.Main.Properties;assembly=Toolkit.Modules.Main"
        xmlns:models="clr-namespace:Toolkit.Modules.Models;assembly=Toolkit.Modules"
        x:DataType="vm:AppWizardViewModel"
        Title="{x:Static res:MainResource.TitleAppWizard}"
        Width="600"
        Height="620"
        MinWidth="500"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <GroupBox Header="{x:Static res:MainResource.GrpMode}"
                      Padding="10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:MainResource.LblAppName}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding AppName}"
                                 PlaceholderText="请输入程序名称"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:MainResource.GrpTenant}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding TenantModeOptions}"
                                  SelectedItem="{Binding SelectedTenantMode}"
                                  ItemContainerTheme="{StaticResource OptionComboBoxItemTheme}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:IOption">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </GroupBox>

            

         

            <GroupBox Header="{x:Static res:MainResource.GrpLogin}"
                      Padding="10"
                      Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox Content="{x:Static res:MainResource.LblUsePassword}"
                              IsChecked="{Binding LoginUsePassword}"
                              Margin="0,0,0,5"/>

                    <Grid IsVisible="{Binding LoginUsePassword}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:MainResource.LblLoginPassword}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding LoginPassword}"
                                 PasswordChar="*"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static res:MainResource.GrpSecurity}"
                      Padding="10"
                      Margin="0,10,0,0">
                <CheckBox Content="{x:Static res:MainResource.LblDataEncryption}"
                          IsChecked="{Binding UseDataEncryption}"/>
            </GroupBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">
                <Button Content="{x:Static res:MainResource.BtnCancel}"
                        Click="OnCancelClick"
                        Padding="25,10"
                        Margin="0,0,10,0"/>
                <Button Content="{x:Static res:MainResource.BtnConfirm}"
                        Command="{Binding ConfirmCommand}"
                        Padding="25,10"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>