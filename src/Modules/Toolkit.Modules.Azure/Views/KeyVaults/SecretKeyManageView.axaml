<Window x:Class="Toolkit.Modules.Azure.Views.KeyVaults.SecretKeyManageView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.KeyVaults;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Properties;assembly=Toolkit.Modules.Resources"
        x:DataType="vm:SecretKeyManageViewModel"
        Title="{x:Static res:FormResources.TitleSecretManage}"
        Width="900"
        Height="560"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static res:FormResources.BtnAdd}"
                            Command="{Binding AddCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnEdit}"
                            Command="{Binding EditCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnDelete}"
                            Command="{Binding DeleteCommand}"
                            Padding="20,8"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{x:Static res:FormResources.LblFilter}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBox Text="{Binding FilterText}"
                             PlaceholderText="筛选Key或描述"
                             Width="150"
                             Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnImport}"
                            Command="{Binding ImportCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnExport}"
                            Command="{Binding ExportCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnRefresh}"
                            Command="{Binding RefreshCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:FormResources.BtnSave}"
                            Command="{Binding SaveCommand}"
                            Padding="20,8"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="10,0"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:FormResources.ColKeyName}"
                                    Binding="{Binding Key}"
                                    Width="*"/>
                <DataGridCheckBoxColumn Header="{x:Static res:FormResources.LblRequired}"
                                        Binding="{Binding Required}"
                                        Width="80"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.LblType}"
                                    Binding="{Binding Type}"
                                    Width="100"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.LblDescription}"
                                    Binding="{Binding Description}"
                                    Width="*"/>
                <DataGridTextColumn Header="{x:Static res:FormResources.LblTags}"
                                    Binding="{Binding Tags, Converter={StaticResource TagsToString}}"
                                    Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Margin="10"
                   Text="{Binding HasChanges, StringFormat=当前有未保存的更改: {0}}"
                   IsVisible="{Binding HasChanges}"/>
    </Grid>
</Window>