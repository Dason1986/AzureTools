<Window x:Class="Toolkit.Modules.Azure.Views.KeyVaults.KeyVaultSecretHistoriesView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.KeyVaults;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Azure.Properties;assembly=Toolkit.Modules.Azure"
        x:DataType="vm:KeyVaultSecretHistoriesViewModel"
        Title="{Binding Title}"
        Width="1300"
        Height="780"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
 

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Content="{x:Static res:AzureResource.BtnExport}"
                Command="{Binding ExportCommand}"
                Padding="20,8"
                Margin="10"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Secrets}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="10,0,10,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblName}"
                                    Binding="{Binding Name}"
                                    Width="*"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblValue}"
                                    Binding="{Binding Value}"
                                    Width="*"/>
                <DataGridCheckBoxColumn Header="{x:Static res:AzureResource.LblEnabled}"
                                        Binding="{Binding Enabled}"
                                        Width="60"/>
                <DataGridCheckBoxColumn Header="{x:Static res:AzureResource.LblRequired}"
                                        Binding="{Binding Required}"
                                        Width="60"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblCreated}"
                                    Binding="{Binding Created, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                                    Width="140"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblUpdated}"
                                    Binding="{Binding Updated, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                                    Width="140"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblExpires}"
                                    Binding="{Binding Expires, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                                    Width="140"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblDescription}"
                                    Binding="{Binding Description}"
                                    Width="200"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblTags}"
                                    Binding="{Binding Tags, Converter={StaticResource TagsToString}}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>