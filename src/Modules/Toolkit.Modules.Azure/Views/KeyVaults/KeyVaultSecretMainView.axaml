<Window x:Class="Toolkit.Modules.Azure.Views.KeyVaults.KeyVaultSecretMainView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.KeyVaults;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Azure.Properties;assembly=Toolkit.Modules.Azure"
        xmlns:models="clr-namespace:Toolkit.Modules.Azure.Models;assembly=Toolkit.Modules.Azure"
        xmlns:mainModels="clr-namespace:Toolkit.Modules.Models;assembly=Toolkit.Modules" 
        x:DataType="vm:KeyVaultSecretMainViewModel"
        Title="KeyVault Secret"
        Width="380"
        Height="560"
        MinWidth="340"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <ComboBox ItemsSource="{Binding ProjectList}"
                      SelectedItem="{Binding SelectedProject}"
                      Margin="0,0,0,10"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="mainModels:ProjectInfo">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <GroupBox Header="{x:Static res:AzureResource.GrpEnterEnv}"
                      Padding="10">
                <StackPanel>
                    <TextBlock Text="{x:Static res:AzureResource.LblSelectEnterEnv}"
                               Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding KeyVaultOptionsList}"
                              SelectedItem="{Binding SelectedKeyVaultOption}"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyVaultEnv">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{x:Static res:AzureResource.BtnEnter}"
                            Command="{Binding EnterKeyVaultCommand}"
                            HorizontalAlignment="Right"
                            Padding="20,8"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static res:AzureResource.GrpCompareEnv}"
                      IsEnabled="{Binding IsCompareEnabled}"
                      Padding="10"
                      Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:AzureResource.LblSelectCompareEnv}"
                               Margin="0,0,0,5"/>
                    <ListBox ItemsSource="{Binding KeyVaultOptionsList}"
                             SelectionMode="Multiple"
                             SelectionChanged="OnCompareSelectionChanged"
                             Height="120"
                             Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyVaultEnv">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="{x:Static res:AzureResource.BtnCompare}"
                            Command="{Binding CompareCommand}"
                            HorizontalAlignment="Right"
                            Padding="20,8"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static res:AzureResource.GrpConfig}"
                      Padding="10"
                      Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static res:AzureResource.BtnSecretManage}"
                            Command="{Binding SecretKeyManageCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:AzureResource.BtnEnvManage}"
                            Command="{Binding EnvManageCommand}"
                            Padding="20,8"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>