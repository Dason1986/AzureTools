<Window x:Class="Toolkit.Modules.Azure.Views.KeyVaults.SecretKeyEditorView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.KeyVaults;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Properties;assembly=Toolkit.Modules.Resources"
        x:DataType="vm:SecretKeyEditorViewModel"
        Title="{x:Static res:FormResources.TitleSecretKeyEdit}"
        Width="500"
        Height="580"
        MinWidth="450"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15" Spacing="8">
            <DockPanel>
                <TextBlock Text="{x:Static res:FormResources.LblKey}" Classes="field-label"/>
                <TextBox Text="{Binding Key}"
                         IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolean}}"
                         PlaceholderText="请输入Key名称"/>
            </DockPanel>

            <DockPanel>
                <TextBlock Text="{x:Static res:FormResources.LblType}" Classes="field-label"/>
                <ComboBox ItemsSource="{Binding AvailableTypes}"
                          SelectedItem="{Binding Type}"
                          IsEnabled="{Binding IsEditMode, Converter={StaticResource InvertedBoolean}}"/>
            </DockPanel>
 
              <DockPanel>
                <TextBlock Text="{x:Static res:FormResources.LblRequired}" Classes="field-label"/>
                <CheckBox IsChecked="{Binding Required}"/>
            </DockPanel>
        

            <DockPanel>
                <TextBlock Text="{x:Static res:FormResources.LblDescription}" Classes="field-label" VerticalAlignment="Top"/>
                <TextBox Text="{Binding Description}"
                         AcceptsReturn="True"
                         Height="60"
                         TextWrapping="Wrap"
                         PlaceholderText="请输入描述"/>
            </DockPanel>

            <DockPanel>
                <TextBlock Text="{x:Static res:FormResources.LblTags}" Classes="field-label"/>
                <TextBox Text="{Binding TagsText}"
                         PlaceholderText="多个标签以逗号分隔"/>
            </DockPanel>

            <Separator Margin="0,5,0,5"/>

            <!-- Default validation options (ErrorMessage only) -->
            <DockPanel IsVisible="{Binding IsDefaultType}">
                <TextBlock Text="错误信息" Classes="field-label"/>
                <TextBox Text="{Binding ErrorMessage}"
                         PlaceholderText="请输入验证失败时的错误信息"/>
            </DockPanel>

            <!-- Pfx_Password validation options -->
            <StackPanel IsVisible="{Binding IsPfxPasswordType}" Spacing="8">
                <DockPanel>
                    <TextBlock Text="密码Key" Classes="field-label"/>
                    <TextBox Text="{Binding PasswordKey}"
                             PlaceholderText="请输入密码引用的Key名称"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="错误信息" Classes="field-label"/>
                    <TextBox Text="{Binding ErrorMessage}"
                             PlaceholderText="请输入验证失败时的错误信息"/>
                </DockPanel>
            </StackPanel>

            <!-- Number validation options -->
            <StackPanel IsVisible="{Binding IsNumberType}" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox Content="最小值"
                              IsChecked="{Binding HasMin}"/>
                    <NumericUpDown Value="{Binding MinValue}"
                                   IsEnabled="{Binding HasMin}"/>
                    <CheckBox Content="最大值"
                              IsChecked="{Binding HasMax}"/>
                    <NumericUpDown Value="{Binding MaxValue}"
                                   IsEnabled="{Binding HasMax}"/>
                </StackPanel>
                <DockPanel>
                    <TextBlock Text="错误信息" Classes="field-label"/>
                    <TextBox Text="{Binding ErrorMessage}"
                             PlaceholderText="请输入验证失败时的错误信息"/>
                </DockPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{x:Static res:FormResources.BtnCancel}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Classes="form-action"
                        Margin="0,0,10,0"/>
                <Button Content="{x:Static res:FormResources.BtnConfirm}"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"
                        Classes="form-action"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>