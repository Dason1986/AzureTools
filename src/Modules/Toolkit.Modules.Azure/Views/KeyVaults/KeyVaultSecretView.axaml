<Window x:Class="Toolkit.Modules.Azure.Views.KeyVaults.KeyVaultSecretView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.KeyVaults;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Properties;assembly=Toolkit.Modules.Resources"
        x:DataType="vm:KeyVaultSecretViewModel"
        Title="{Binding WindowTitle}"
        Width="1300"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
          <Button Content="{x:Static res:FormResources.BtnGetSettings}"
                  Command="{Binding GetAllCommand}"
                  Padding="20,8"
                  Margin="0,0,10,0"/>
          <Button Content="{x:Static res:FormResources.BtnValidator}"
                  Command="{Binding ValidatorCommand}"
                  Padding="20,8"
                  Margin="0,0,10,0"/>
          <Button Content="{x:Static res:FormResources.BtnExport}"
                  Command="{Binding ExportCommand}"
                  Padding="20,8"
                  Margin="0,0,10,0"/>
          <Button Content="{x:Static res:FormResources.BtnRecycle}"
                  Command="{Binding RecycleCommand}"
                  Padding="20,8"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <GroupBox Header="{x:Static res:FormResources.GrpSetExpiration}"
                    Padding="8"
                    Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal">
              <DatePicker SelectedDate="{Binding ExpirationDate}"
                          Margin="0,0,10,0"/>
              <Button Content="{x:Static res:FormResources.BtnSetAll}"
                      Command="{Binding SetAllExpirationCommand}"
                      Padding="15,5"
                      Margin="0,0,5,0"/>
              <Button Content="{x:Static res:FormResources.BtnSetSelected}"
                      Command="{Binding SetOneExpirationCommand}"
                      Padding="15,5"/>
            </StackPanel>
          </GroupBox>   
          <GroupBox Header="Tools"
                    Padding="8"
                    Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Content="Cer File"
                Command="{Binding CerFileCommand}"
                Padding="20,8"
                Margin="0,0,0,10"/>

              <Button Content="Rsa File"
                      Command="{Binding RsaFileCommand}"
                      Padding="20,8"
                      Margin="0,0,0,10"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </DockPanel>

      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBlock Text="{x:Static res:FormResources.LblFilter}"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0"/>
        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="Name / Value"
                 MinWidth="300"/>
      </StackPanel>
    </StackPanel>

    <DataGrid Grid.Row="1"
              ItemsSource="{Binding FilteredKeyVaults}"
              SelectedItem="{Binding SelectedSecretItem}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              Margin="10,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblName}"
                            Binding="{Binding Name}"
                            Width="*"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblRule}"
                            Binding="{Binding Rule}"
                            Width="80"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblValue}"
                            Binding="{Binding Value}"
                            Width="*"/>
        <DataGridCheckBoxColumn Header="{x:Static res:FormResources.LblEnabled}"
                                Binding="{Binding Enabled}"
                                Width="80"/>
        <DataGridCheckBoxColumn Header="{x:Static res:FormResources.LblRequired}"
                                Binding="{Binding Required}"
                                Width="80"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblCreated}"
                            Binding="{Binding Created, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                            Width="140"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblUpdated}"
                            Binding="{Binding Updated, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                            Width="140"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblExpires}"
                            Binding="{Binding Expires, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                            Width="140"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblDescription}"
                            Binding="{Binding Description}"
                            Width="200"/>
        <DataGridTextColumn Header="{x:Static res:FormResources.LblTags}"
                            Binding="{Binding Tags, Converter={StaticResource TagsToString}}"
                            Width="120"/>
      </DataGrid.Columns>
    </DataGrid>

    <GroupBox Grid.Row="2"
              Header="{x:Static res:FormResources.LblValue}"
              Padding="10"
              Margin="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,5">
          <TextBlock Text="{x:Static res:FormResources.LblDescription}"
                     FontWeight="Bold"/>
          <TextBlock Text="{Binding SelectedSecretItem.Description}"
                     TextWrapping="Wrap"
                     Margin="0,2,0,5"/>
          <TextBlock Text="{x:Static res:FormResources.LblTags}"
                     FontWeight="Bold"/>
          <TextBlock Text="{Binding SelectedSecretItem.Tags, Converter={StaticResource TagsToString}}"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox Grid.Column="0"
                 Grid.Row="1"
                 Text="{Binding CurrentValue}"
                 AcceptsReturn="True"
                 Margin="0,10,0,0"/>

        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Orientation="Vertical"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="10,0,0,0">
      
          <Button Content="{x:Static res:FormResources.BtnHistory}"
                  Command="{Binding HistoryCommand}"
                  Padding="20,8"
                  Margin="0,0,0,10"/>
          <Button Content="{x:Static res:FormResources.BtnUpdate}"
                  Command="{Binding UpdateCommand}"
                  Padding="20,8"/>
        </StackPanel>
      </Grid>
    </GroupBox>
  </Grid>
</Window>