<Window x:Class="Toolkit.Modules.Azure.Views.KeyVaults.KeyVaultSecretRecycleView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.KeyVaults;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Azure.Properties;assembly=Toolkit.Modules.Azure"
        x:DataType="vm:KeyVaultSecretRecycleViewModel"
        Title="{Binding WindowTitle}"
        Width="860"
        Height="500"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="{x:Static res:AzureResource.BtnRefresh}"
                    Command="{Binding RefreshenCommand}"
                    Padding="20,8"
                    Margin="0,0,10,0"/>
            <Button Content="{x:Static res:AzureResource.BtnClearSelected}"
                    Command="{Binding DeleteCommand}"
                    Padding="20,8"
                    Margin="0,0,10,0"/>
            <Button Content="{x:Static res:AzureResource.BtnRestoreSelected}"
                    Command="{Binding RecoveryCommand}"
                    Padding="20,8"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding DeletedSecrets}"
                  SelectedItem="{Binding SelectedSecretItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="10,0,10,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblName}"
                                    Binding="{Binding Name}"
                                    Width="*"/>
                <DataGridCheckBoxColumn Header="{x:Static res:AzureResource.LblEnabled}"
                                        Binding="{Binding Enabled}"
                                        Width="80"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblCreated}"
                                    Binding="{Binding Created}"
                                    Width="140"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblUpdated}"
                                    Binding="{Binding Updated}"
                                    Width="140"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblExpires}"
                                    Binding="{Binding Expires}"
                                    Width="140"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblDeleted}"
                                    Binding="{Binding Deleted}"
                                    Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
