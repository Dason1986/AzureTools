<Window x:Class="Toolkit.Modules.Azure.Views.ContainerRegistries.ContainerRegistryEnvManageView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.ContainerRegistries;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Azure.Properties;assembly=Toolkit.Modules.Azure"
        
        x:DataType="vm:ContainerRegistryEnvManageViewModel"
        Title="{x:Static res:AzureResource.TitleEnvManage}"
        Width="980"
        Height="560"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- <Button Content="{x:Static res:AzureResource.BtnAdd}"
                            Command="{Binding AddCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/> -->
                    <Button Content="{x:Static res:AzureResource.BtnEdit}"
                            Command="{Binding EditCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:AzureResource.BtnDelete}"
                            Command="{Binding DeleteCommand}"
                            Padding="20,8"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{x:Static res:AzureResource.BtnImport}"
                            Command="{Binding ImportCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:AzureResource.BtnRefresh}"
                            Command="{Binding RefreshCommand}"
                            Padding="20,8"
                            Margin="0,0,10,0"/>
                    <Button Content="{x:Static res:AzureResource.BtnSave}"
                            Command="{Binding SaveCommand}"
                            Padding="20,8"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  Margin="10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblName}"
                                    Binding="{Binding Name}"
                                    Width="*"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblRegistry}"
                                    Binding="{Binding Registry}"
                                    Width="*"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblCreated}"
                                    Binding="{Binding CreatedOn, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd}"
                                    Width="120"/>
                <DataGridCheckBoxColumn Header="{x:Static res:AzureResource.LblAdminUserEnabled}"
                                        Binding="{Binding IsAdminUserEnabled}"
                                        Width="130"/>
                <DataGridCheckBoxColumn Header="{x:Static res:AzureResource.LblAnonymousPullEnabled}"
                                        Binding="{Binding IsAnonymousPullEnabled}"
                                        Width="130"/>
                <DataGridTextColumn Header="{x:Static res:AzureResource.LblSubscriptionName}"
                                    Binding="{Binding SubscriptionName}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Margin="10"
                   Text="{Binding HasChanges, StringFormat=当前有未保存的更改: {0}}"
                   IsVisible="{Binding HasChanges}"/>
    </Grid>
</Window>
