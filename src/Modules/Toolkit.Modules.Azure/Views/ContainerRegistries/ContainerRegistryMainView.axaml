<Window x:Class="Toolkit.Modules.Azure.Views.ContainerRegistries.ContainerRegistryMainView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.ContainerRegistries;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Azure.Properties;assembly=Toolkit.Modules.Azure"
        xmlns:models="clr-namespace:Toolkit.Modules.Azure.Models;assembly=Toolkit.Modules.Azure"
        x:DataType="vm:ContainerRegistryMainViewModel"
        Title="Container Registry"
        Width="380"
        Height="360"
        MinWidth="340"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <GroupBox Header="{x:Static res:AzureResource.GrpEnterEnv}"
                      Padding="10">
                <StackPanel>
                    <TextBlock Text="{x:Static res:AzureResource.LblSelectEnterEnv}"
                               Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding ContainerRegistryOptionsList}"
                              SelectedItem="{Binding SelectedContainerRegistryOption}"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ContainerRegistryEnv">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{x:Static res:AzureResource.BtnEnter}"
                            Command="{Binding QueryCommand}"
                            HorizontalAlignment="Right"
                            Padding="20,8"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static res:AzureResource.GrpConfig}"
                      Padding="10"
                      Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static res:AzureResource.BtnEnvManage}"
                            Command="{Binding EnvManageCommand}"
                            Padding="20,8"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
