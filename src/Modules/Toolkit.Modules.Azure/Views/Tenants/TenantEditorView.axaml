<Window x:Class="Toolkit.Modules.Azure.Views.Tenants.TenantEditorView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.Tenants;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Properties;assembly=Toolkit.Modules.Resources"
        xmlns:models="clr-namespace:Toolkit.Modules.Models;assembly=Toolkit.Modules"
        x:DataType="vm:TenantEditorViewModel"
        Title="{x:Static res:FormResources.TitleEditTenant}"
        Width="500"
        Height="520"
        MinWidth="450"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="15" Spacing="8">
      <DockPanel>
        <TextBlock Text="{x:Static res:FormResources.LblTenantCode}" Classes="field-label"/>
        <TextBox Text="{Binding TenantCode}"
                 PlaceholderText="请输入租户代码"/>
      </DockPanel>

      <DockPanel>
        <TextBlock Text="{x:Static res:FormResources.LblTenantName}" Classes="field-label"/>
        <TextBox Text="{Binding TenantName}"
                 PlaceholderText="请输入租户名称"/>
      </DockPanel>

      <DockPanel>
        <TextBlock Text="{x:Static res:FormResources.LblTenantId}" Classes="field-label"/>
        <TextBox Text="{Binding TenantId}"
                 PlaceholderText="请输入租户ID (GUID)"/>
      </DockPanel>

      <DockPanel>
        <TextBlock Text="{x:Static res:FormResources.LblClientId}" Classes="field-label"/>
        <TextBox Text="{Binding ClientId}"
                 PlaceholderText="请输入程序ID (GUID)"/>
      </DockPanel>

      <DockPanel>
        <TextBlock Text="{x:Static res:FormResources.LblCredential}" Classes="field-label"/>
        <ComboBox ItemsSource="{Binding CredentialOptions}"
                  SelectedItem="{Binding SelectedCredential}"
                  ItemContainerTheme="{StaticResource OptionComboBoxItemTheme}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:IOption">
              <TextBlock Text="{Binding DisplayName}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>

      <GroupBox Header="{x:Static res:FormResources.GrpCertificate}"
                IsVisible="{Binding IsCertificateEnabled}"
                Padding="10">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock Text="证书" Classes="field-label"/>
            <Button Content="创建证书"
                    Command="{Binding CerFileCommand}"
                    Padding="20,8"
                    DockPanel.Dock="Right"
                    Margin="5,0,0,0"/>
            <Button Content="{x:Static res:FormResources.BtnOk}"
                    Command="{Binding SelectCertificateCommand}"
                    Padding="15,5"
                    Margin="5,0,0,0"
                    DockPanel.Dock="Right"/>
            <TextBox Text="{Binding CertificateRawData}"
                     IsReadOnly="True"
                     PlaceholderText="请选择证书文件"/>
          </DockPanel>
          <DockPanel IsVisible="{Binding IsPasswordEnabled}">
            <TextBlock Text="{x:Static res:FormResources.LblPassword}" Classes="field-label"/>
            <TextBox Text="{Binding Password}"
                     PasswordChar="*"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,10,0,0">
        <Button Content="{x:Static res:FormResources.BtnTest}"
                Command="{Binding TestConnectionCommand}"
                Classes="form-action"
                Margin="0,0,10,0"/>
        <Button Content="{x:Static res:FormResources.BtnCancel}"
                Command="{Binding CancelCommand}"
                IsCancel="True"
                Classes="form-action"
                Margin="0,0,10,0"/>
        <Button Content="{x:Static res:FormResources.BtnConfirm}"
                Command="{Binding ConfirmCommand}"
                IsDefault="True"
                Classes="form-action"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>