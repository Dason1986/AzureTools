<Window x:Class="Toolkit.Modules.Azure.Views.AppContainers.AppContainerDetailView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Azure.ViewModels.AppContainers;assembly=Toolkit.Modules.Azure"
        xmlns:res="clr-namespace:Toolkit.Modules.Properties;assembly=Toolkit.Modules.Resources"
        x:DataType="vm:AppContainerDetailViewModel"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="650"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{x:Static res:FormResources.BtnRefresh}"
                    Command="{Binding RefreshCommand}"
                    Padding="15,4"
                    Margin="0,0,10,0"/>
            <ProgressBar IsVisible="{Binding IsLoading}"
                         IsIndeterminate="True"
                         Width="200"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <TabControl Grid.Row="1" IsVisible="{Binding !IsLoading}">

            <!-- 基本信息 -->
            <TabItem Header="{x:Static res:FormResources.TabBasicInfo}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:FormResources.LblName}" Classes="field-label" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.Name}" Margin="0,5"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:FormResources.LblEnvironmentName}" Classes="field-label" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Detail.EnvironmentName}" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:FormResources.LblState}" Classes="field-label" Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.ProvisioningState}" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static res:FormResources.LblRunningStatus}" Classes="field-label" Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Detail.RunningStatus}" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:FormResources.LblLocation}" Classes="field-label" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.Location}" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Static res:FormResources.LblLatestRevision}" Classes="field-label" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Detail.LatestRevisionName}" Margin="0,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:FormResources.LblLatestReadyRevision}" Classes="field-label" Margin="0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.LatestReadyRevisionName}" Margin="0,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{x:Static res:FormResources.LblLatestRevisionFqdn}" Classes="field-label" Margin="0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Detail.LatestRevisionFqdn}" Margin="0,5" TextWrapping="Wrap"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Revisions -->
            <TabItem Header="{x:Static res:FormResources.TabRevisions}">
                <DataGrid ItemsSource="{Binding Revisions}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblName}"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblRunningState}"
                                            Binding="{Binding RunningState}"
                                            Width="100"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblHealthState}"
                                            Binding="{Binding HealthState}"
                                            Width="100"/>
                        <DataGridCheckBoxColumn Header="{x:Static res:FormResources.LblIsActive}"
                                                Binding="{Binding IsActive}"
                                                Width="100"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblReplicas}"
                                            Binding="{Binding Replicas}"
                                            Width="100"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblTrafficWeight}"
                                            Binding="{Binding TrafficWeight}"
                                            Width="100"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblCreated}"
                                            Binding="{Binding CreatedOn, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                                            Width="160"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblLastActiveOn}"
                                            Binding="{Binding LastActiveOn, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                                            Width="180"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblFqdn}"
                                            Binding="{Binding Fqdn}"
                                            Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Replicas -->
            <TabItem Header="{x:Static res:FormResources.TabReplicas}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,5">
                        <Button Content="{x:Static res:FormResources.BtnDetail}"
                                Command="{Binding ViewReplicaDetailCommand}"
                                Padding="15,4"/>
                      <Button Content="{x:Static res:FormResources.BtnRestart}"
                               Command="{Binding RevisionRestartCommand}"
                               Padding="15,4"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Replicas}"
                              SelectedItem="{Binding SelectedReplica}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblName}"
                                                Binding="{Binding Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblRevision}"
                                                Binding="{Binding RevisionName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblRunningState}"
                                                Binding="{Binding RunningState}"
                                                Width="100"/>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblCreated}"
                                                Binding="{Binding CreatedOn, Converter={StaticResource DateTimeFormat}, ConverterParameter=yyyy-MM-dd HH:mm}"
                                                Width="160"/>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblContainer}"
                                                Binding="{Binding ContainerName}"
                                                Width="120"/>
                            <DataGridCheckBoxColumn Header="{x:Static res:FormResources.LblReady}"
                                                    Binding="{Binding ContainerReady}"
                                                    Width="80"/>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblRestartCount}"
                                                Binding="{Binding ContainerRestartCount}"
                                                Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Scale -->
            <TabItem Header="{x:Static res:FormResources.TabScale}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                    <StackPanel Margin="5" Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:FormResources.LblMinReplicas}" Classes="field-label" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.Scale.MinReplicas}" Margin="0,5"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:FormResources.LblMaxReplicas}" Classes="field-label" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Detail.Scale.MaxReplicas}" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:FormResources.LblCooldownPeriod}" Classes="field-label" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.Scale.CooldownPeriod}" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static res:FormResources.LblPollingInterval}" Classes="field-label" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Detail.Scale.PollingInterval}" Margin="0,5"/>
                        </Grid>

                        <TextBlock Text="{x:Static res:FormResources.LblScaleRules}" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ItemsControl ItemsSource="{Binding Detail.Scale.ScaleRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="10,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Volumes -->
            <TabItem Header="{x:Static res:FormResources.TabVolumes}">
                <DataGrid ItemsSource="{Binding Detail.Volumes}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblName}"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblStorageType}"
                                            Binding="{Binding StorageType}"
                                            Width="150"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblStorageName}"
                                            Binding="{Binding StorageName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{x:Static res:FormResources.LblMountOptions}"
                                            Binding="{Binding MountOptions}"
                                            Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Environment Variables -->
            <TabItem Header="{x:Static res:FormResources.TabEnvironment}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="{x:Static res:FormResources.LblFilter}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBox Text="{Binding EnvVarFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Name / Value"
                                 MinWidth="300"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredEnvironmentVariables}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblName}"
                                                Binding="{Binding Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblEnvVarValue}"
                                                Binding="{Binding Value}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="{x:Static res:FormResources.LblSecretRef}"
                                                Binding="{Binding SecretRef}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
