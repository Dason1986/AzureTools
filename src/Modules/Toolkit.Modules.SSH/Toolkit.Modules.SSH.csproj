<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ScottPlot.Avalonia" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AzureTools.Abstractions\AzureTools.Abstractions.csproj" />
    <ProjectReference Include="..\..\AzureTools.Avalonia\AzureTools.Avalonia.csproj" />
    <ProjectReference Include="..\Toolkit.Modules\Toolkit.Modules.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\SSHResource.Designer.cs">
      <DependentUpon>SSHResource.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Views\ContainerRuntime\BrowserView.axaml.cs">
      <DependentUpon>BrowserView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ContainerRuntime\ContainerDetailView.axaml.cs">
      <DependentUpon>ContainerDetailView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ContainerRuntime\ContainerMonitorView.axaml.cs">
      <DependentUpon>ContainerMonitorView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ContainerRuntime\NetworkDetailView.axaml.cs">
      <DependentUpon>NetworkDetailView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ContainerRuntime\ImageDetailView.axaml.cs">
      <DependentUpon>ImageDetailView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ContainerRuntime\ImageTagsView.axaml.cs">
      <DependentUpon>ImageTagsView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\SSHResource.resx">
      <LastGenOutput>SSHResource.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>
</Project>
