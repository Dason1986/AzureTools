<UserControl x:Class="Toolkit.Modules.SSH.Views.ContainerRuntime.Tabs.NetworksTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Modules.SSH.ViewModels.ContainerRuntime;assembly=Toolkit.Modules.SSH"
             xmlns:resSSH="clr-namespace:Toolkit.Modules.SSH.Properties;assembly=Toolkit.Modules.SSH"
             x:DataType="vm:NetworksTabViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
      <Button Content="{x:Static resSSH:SSHResource.BtnRefresh}"
              Command="{Binding RefreshCommand}"
              Padding="15,6"
              Margin="0,0,8,0"/>
      <Button Content="{x:Static resSSH:SSHResource.BtnCreate}"
              Command="{Binding CreateNetworkCommand}"
              Padding="15,6"
              Margin="0,0,8,0"/>
      <Button Content="{x:Static resSSH:SSHResource.BtnPrune}"
              Command="{Binding PruneNetworksCommand}"
              Padding="15,6"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <DataGrid Grid.Column="0"
                ItemsSource="{Binding Networks}"
                SelectedItem="{Binding SelectedNetwork}"
                AutoGenerateColumns="False"
                IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColContainerName}" Binding="{Binding Name}" Width="200"/>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColNetworkId}" Binding="{Binding Id}" Width="260"/>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDriver}" Binding="{Binding Driver}" Width="120"/>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColScope}" Binding="{Binding Scope}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0" Spacing="6">
        <Button Content="{x:Static resSSH:SSHResource.BtnDetail}" Command="{Binding DetailNetworkCommand}" Padding="15,6" HorizontalAlignment="Stretch"/>
        <Button Content="{x:Static resSSH:SSHResource.BtnRemove}" Command="{Binding RemoveNetworkCommand}" Padding="15,6" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
