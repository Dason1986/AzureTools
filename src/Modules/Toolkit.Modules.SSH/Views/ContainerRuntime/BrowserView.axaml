<Window x:Class="Toolkit.Modules.SSH.Views.ContainerRuntime.BrowserView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.SSH.ViewModels.ContainerRuntime;assembly=Toolkit.Modules.SSH"
        x:DataType="vm:BrowserViewModel"
        Title="{Binding WindowTitle}"
        Width="980"
        Height="600"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <TabControl SelectedIndex="{Binding TabIndex}"
              ItemsSource="{Binding TabItems}"
              Margin="8"/>
</Window>
