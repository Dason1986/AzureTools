<Window x:Class="Toolkit.Modules.SSH.Views.ContainerRuntime.PodEditView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.SSH.ViewModels.ContainerRuntime;assembly=Toolkit.Modules.SSH"
        xmlns:resSSH="clr-namespace:Toolkit.Modules.SSH.Properties;assembly=Toolkit.Modules.SSH"
        x:DataType="vm:PodEditViewModel"
        Title="{Binding WindowTitle}"
        Width="720"
        Height="520"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{x:Static resSSH:SSHResource.BtnDone}"
              Command="{Binding DoneCommand}"
              Padding="20,8"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="{x:Static resSSH:SSHResource.LblPodName}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox Text="{Binding PodName}" IsReadOnly="True" Width="240"/>
      <Button Content="{x:Static resSSH:SSHResource.BtnRefresh}"
              Command="{Binding LoadContainersCommand}"
              IsEnabled="{Binding !IsBusy}"
              Padding="15,6"
              Margin="8,0,0,0"/>
      <Button Content="{x:Static resSSH:SSHResource.BtnAddContainer}"
              Command="{Binding AddContainerCommand}"
              IsEnabled="{Binding !IsBusy}"
              Padding="15,6"
              Margin="8,0,0,0"/>
      <Button Content="{x:Static resSSH:SSHResource.BtnRemove}"
              Command="{Binding RemoveContainerCommand}"
              IsEnabled="{Binding !IsBusy}"
              Padding="15,6"
              Margin="8,0,0,0"/>
    </StackPanel>

    <DataGrid ItemsSource="{Binding Containers}"
              SelectedItem="{Binding SelectedContainer}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColContainerName}" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColContainerImage}" Binding="{Binding Image}" Width="2*"/>
        <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColContainerStatus}" Binding="{Binding Status}" Width="130"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
