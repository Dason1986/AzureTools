<Window x:Class="Toolkit.Modules.SSH.Views.ContainerRuntime.ImageSearchView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.SSH.ViewModels.ContainerRuntime;assembly=Toolkit.Modules.SSH"
        xmlns:resSSH="clr-namespace:Toolkit.Modules.SSH.Properties;assembly=Toolkit.Modules.SSH"
        x:DataType="vm:ImageSearchViewModel"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="520"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
      <TextBox Text="{Binding Keyword}"
               PlaceholderText="{x:Static resSSH:SSHResource.PromptImageSearchKeyword}"
               Width="360"
               VerticalAlignment="Center"/>
      <Button Content="{x:Static resSSH:SSHResource.BtnSearch}"
              Command="{Binding SearchCommand}"
              IsEnabled="{Binding !IsBusy}"
              Padding="15,6"
              Margin="8,0,0,0"/>
      <Button Content="{x:Static resSSH:SSHResource.BtnPullDirect}"
              Command="{Binding PullDirectlyCommand}"
              IsEnabled="{Binding !IsBusy}"
              Padding="15,6"
              Margin="8,0,0,0"/>
      <Button Content="{x:Static resSSH:SSHResource.BtnPullImage}"
              Command="{Binding PullImageCommand}"
              IsEnabled="{Binding !IsBusy}"
              Padding="15,6"
              Margin="8,0,0,0"/>
    </StackPanel>
    <ProgressBar DockPanel.Dock="Bottom"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}"
                 Height="4"
                 Margin="0,8,0,0"/>
    <DataGrid ItemsSource="{Binding Images}"
              SelectedItem="{Binding SelectedImage}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColImageName}" Binding="{Binding Name}" Width="340"/>
        <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColImageDescription}" Binding="{Binding Description}" Width="*"/>
        <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColImageStars}" Binding="{Binding StarCount}" Width="180"/>
        <DataGridCheckBoxColumn Header="{x:Static resSSH:SSHResource.ColImageOfficial}" Binding="{Binding IsOfficial}" Width="170" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
