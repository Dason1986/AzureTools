<Window x:Class="Toolkit.Modules.SSH.Views.ContainerRuntime.ImageDetailView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.SSH.ViewModels.ContainerRuntime;assembly=Toolkit.Modules.SSH"
        xmlns:resSSH="clr-namespace:Toolkit.Modules.SSH.Properties;assembly=Toolkit.Modules.SSH"
        x:DataType="vm:ImageDetailViewModel"
        Title="{Binding WindowTitle}"
        Width="880"
        Height="560"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
      <Button Content="{x:Static resSSH:SSHResource.BtnRefresh}"
              Command="{Binding RefreshCommand}"
              Padding="15,6"/>
    </StackPanel>
    <TabControl>
      <TabItem Header="{x:Static resSSH:SSHResource.TabDetailBasicInfo}">
        <DataGrid ItemsSource="{Binding BasicInfoFields}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailName}" Binding="{Binding Name}" Width="200"/>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailValue}" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{x:Static resSSH:SSHResource.TabDetailImageConfig}">
        <DataGrid ItemsSource="{Binding ConfigFields}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailName}" Binding="{Binding Name}" Width="200"/>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailValue}" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{x:Static resSSH:SSHResource.TabDetailRepo}">
        <DataGrid ItemsSource="{Binding RepoFields}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailName}" Binding="{Binding Name}" Width="120"/>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailValue}" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{x:Static resSSH:SSHResource.TabDetailEnv}">
        <DataGrid ItemsSource="{Binding EnvFields}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailName}" Binding="{Binding Name}" Width="200"/>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailValue}" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{x:Static resSSH:SSHResource.TabDetailLabels}">
        <DataGrid ItemsSource="{Binding LabelFields}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailName}" Binding="{Binding Name}" Width="200"/>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailValue}" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{x:Static resSSH:SSHResource.TabDetailPorts}">
        <DataGrid ItemsSource="{Binding ExposedPortFields}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailName}" Binding="{Binding Name}" Width="200"/>
            <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColDetailValue}" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="{x:Static resSSH:SSHResource.TabDetailRawJson}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding RawJson}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="8"/>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
