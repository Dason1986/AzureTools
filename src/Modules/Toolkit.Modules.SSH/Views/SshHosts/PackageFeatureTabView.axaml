<UserControl x:Class="Toolkit.Modules.SSH.Views.SshHosts.PackageFeatureTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Modules.SSH.ViewModels.SshHosts;assembly=Toolkit.Modules.SSH"
             xmlns:resSSH="clr-namespace:Toolkit.Modules.SSH.Properties;assembly=Toolkit.Modules.SSH"
             x:DataType="vm:PackageFeatureTabViewModel">
  <StackPanel Margin="10" Spacing="8">
    <CheckBox Content="{x:Static resSSH:SSHResource.LblSshFeatureEnable}"
              IsChecked="{Binding IsEnabled}"/>
    <TextBlock Text="{x:Static resSSH:SSHResource.DescPackageFeature}"
               IsVisible="{Binding IsEnabled}"
               TextWrapping="Wrap"
               Opacity="0.7"/>
  </StackPanel>
</UserControl>
