<Window x:Class="Toolkit.Modules.SSH.Views.SshHosts.SshHostManagementView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.SSH.ViewModels.SshHosts;assembly=Toolkit.Modules.SSH"
        xmlns:resSSH="clr-namespace:Toolkit.Modules.SSH.Properties;assembly=Toolkit.Modules.SSH"
        x:DataType="vm:SshHostManagementViewModel"
        Title="{x:Static resSSH:SSHResource.TitleSshHostManage}"
        Width="900"
        Height="500"
        MinWidth="600"
        MinHeight="350"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="280"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="2*" MinWidth="300"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <Button Content="{x:Static resSSH:SSHResource.BtnRefresh}"
                Command="{Binding RefreshCommand}"
                Padding="20,8"
                DockPanel.Dock="Right"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="{x:Static resSSH:SSHResource.BtnAdd}"
                  Command="{Binding AddCommand}"
                  Padding="20,8"
                  Margin="0,0,10,0"/>
          <Button Content="{x:Static resSSH:SSHResource.BtnEdit}"
                  Command="{Binding EditCommand}"
                  Padding="20,8"
                  Margin="0,0,10,0"/>
          <Button Content="{x:Static resSSH:SSHResource.BtnDelete}"
                  Command="{Binding DeleteCommand}"
                  Padding="20,8"/>
        </StackPanel>
      </DockPanel>
      <DataGrid Grid.Row="1"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColSshHostName}" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColSshHost}" Binding="{Binding Host}" Width="180"/>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColSshPort}" Binding="{Binding Port}" Width="80"/>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColSshUserName}" Binding="{Binding UserName}" Width="120"/>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColSshAuthMode}" Binding="{Binding AuthMode}" Width="120"/>
          <DataGridTextColumn Header="{x:Static resSSH:SSHResource.ColOsVersion}" Binding="{Binding Os}" Width="120"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <GridSplitter Grid.Column="1"
                  Width="6"
                  Margin="4,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Background="Transparent"/>
    <GroupBox Grid.Column="2"
              Header="{x:Static resSSH:SSHResource.GrpSshFeatures}"
              Padding="10">
      <Panel>
        <TextBlock Text="{x:Static resSSH:SSHResource.MsgNoEnabledFeature}"
                   IsVisible="{Binding HasNoFeatureMenu}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !HasNoFeatureMenu}">
          <ItemsControl ItemsSource="{Binding FeatureMenus}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SshFeatureMenuItem">
                <Button Command="{Binding OpenCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{Binding Icon}" Width="18" Height="18"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </GroupBox>
  </Grid>
</Window>