<UserControl x:Class="Toolkit.Modules.SSH.Views.SshHosts.PodmanFeatureTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolkit.Modules.SSH.ViewModels.SshHosts;assembly=Toolkit.Modules.SSH"
             xmlns:resSSH="clr-namespace:Toolkit.Modules.SSH.Properties;assembly=Toolkit.Modules.SSH"
             xmlns:models="clr-namespace:Toolkit.Modules.Models;assembly=Toolkit.Modules"
             x:DataType="vm:PodmanFeatureTabViewModel">
  <StackPanel Margin="10" Spacing="8">
    <CheckBox Content="{x:Static resSSH:SSHResource.LblSshFeatureEnable}"
              IsChecked="{Binding IsEnabled}"/>
    <GroupBox Header="{x:Static resSSH:SSHResource.LblSshPodmanPort}" Padding="10" IsVisible="{Binding IsEnabled}">
      <StackPanel Spacing="8">
        <DockPanel>
          <TextBlock Text="{x:Static resSSH:SSHResource.LblSshPodmanPort}" Classes="field-label"/>
          <TextBox Text="{Binding Port}" PlaceholderText="2375"/>
        </DockPanel>
        <DockPanel>
          <TextBlock Text="{x:Static resSSH:SSHResource.LblSshPodmanApiMode}" Classes="field-label"/>
          <ComboBox ItemsSource="{Binding ApiModeOptions}"
                    SelectedItem="{Binding SelectedApiMode}"
                    ItemContainerTheme="{StaticResource OptionComboBoxItemTheme}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:IOption">
                <TextBlock Text="{Binding DisplayName}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </DockPanel>
      </StackPanel>
    </GroupBox>
  </StackPanel>
</UserControl>
