<Window x:Class="Toolkit.Modules.Comm.Views.Tools.RsaView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Toolkit.Modules.Comm.ViewModels.Tools;assembly=Toolkit.Modules.Comm"
        xmlns:res="clr-namespace:Toolkit.Modules.Properties;assembly=Toolkit.Modules.Resources"
        x:DataType="vm:RsaViewModel"
        Title="{x:Static res:FormResources.TitleRsa}"
        Width="650"
        Height="600"
        MinWidth="550"
        MinHeight="500"
        CanMaximize="False"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="15">

      <DockPanel>
        <Button Content="{x:Static res:FormResources.BtnOk}"
                   Command="{Binding GenerateCommand}" 
                   Padding="25,10"
                   Margin="0,10,0,0"/>
        <Button Content="{x:Static res:FormResources.BtnExport}"
               Command="{Binding ExportCommand}" 
               Padding="25,10"
               Margin="10,10,0,0"/>
      </DockPanel>
 
      <GroupBox Header="{x:Static res:FormResources.LblPublicKey}"
                Padding="10">
        <TextBox Text="{Binding PublicKey}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 Height="120"
                 TextWrapping="Wrap"/>
      </GroupBox>

      <GroupBox Header="{x:Static res:FormResources.LblPrivateKey}"
                Padding="10"
                Margin="0,10,0,0">
        <TextBox Text="{Binding PrivateKey}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 Height="120"
                 TextWrapping="Wrap"/>
      </GroupBox>

      <GroupBox Header="{x:Static res:FormResources.LblPublicKeyBase64}"
                Padding="10"
                Margin="0,10,0,0">
        <TextBox Text="{Binding PublicKeyBase64}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 Height="60"
                 TextWrapping="Wrap"/>
      </GroupBox>

      <GroupBox Header="{x:Static res:FormResources.LblPrivateKeyBase64}"
                Padding="10"
                Margin="0,10,0,0">
        <TextBox Text="{Binding PrivateKeyBase64}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 Height="60"
                 TextWrapping="Wrap"/>
      </GroupBox>
    </StackPanel>
  </ScrollViewer>
</Window>